# Template for the .env file.
#
# Why this file exists: the real .env holds passwords, so it is git-ignored and
# never reaches GitHub. This file is the committed copy with the same variable
# names and placeholder values, so anyone who clones the project knows what to
# set. Docker and the API refuse to start if any of these are missing.
#
# How to use it: copy this file to .env in the same folder, then replace the
# placeholder values. Never put real passwords in this file.
#
#   Windows:  Copy-Item .env.example .env
#   Ubuntu:   cp .env.example .env
#
# docker-compose.yml reads the POSTGRES_* values to create the database.
# The API (backend/SleepyDuck.Api) reads all of them on startup. On a server
# you can set them as real environment variables instead of using a .env file.

# PostgreSQL login. The API connects with these, and Docker creates the
# database with them the first time the container starts.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sleepyduck
POSTGRES_USER=sleepyduck
POSTGRES_PASSWORD=change-me

# App login. The single account that can sign in on the login page.
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=change-me
